# Ignore in all directories
**/.DS_Store

# Environment variables - CRITICAL: Never commit these!
**/.env
**/.env.local
**/.env.development
**/.env.production
**/.env.test
**/.env.staging
# Allow .env.example files for documentation
!**/.env.example

# Credentials and secrets
**/*.key
**/*.pem
**/*.p12
**/*.pfx
**/*secret*
**/*credential*
**/*password*
**/secrets/
**/credentials/
**/.secrets

# Database files
**/*.db
**/*.sqlite
**/*.sqlite3
**/*.db-journal
**/database.dump
**/backup.sql
**/*.dump

# Uploads directory - contains user-uploaded files
**/uploads/
**/uploads/*
!**/uploads/.gitkeep

# Node modules
**/node_modules

# Other dependencies
**/.pnp
**.pnp.js

# Testing
**/coverage
**/.nyc_output
**/test-results/

# Production builds
**/build
**/dist
**/.next
**/out

# Logs - may contain sensitive information
**/*.log
**/logs/
npm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
pnpm-debug.log*

# IDE and editor files
.idea/
.vscode/
*.swp
*.swo
*~
.DS_Store
Thumbs.db

# Temporary files
**/.tmp/
**/tmp/
**/*.tmp
**/*.temp
**/.cache/

# OS files
**/.DS_Store
**/Thumbs.db
**/desktop.ini

# Docker
**/.dockerignore
**/docker-compose.override.yml

# Prisma - generated files
**/prisma/migrations/*.sql
!**/prisma/migrations/migration_lock.toml

# Other sensitive files
**/prompts_master.md
**/*.bak
**/*.backup
**/*.old

# Security and Setup directories - may contain sensitive information
SECURITY/
SETUP/
# Allow setup.sh script to be tracked
!SETUP/setup.sh